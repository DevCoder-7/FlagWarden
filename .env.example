ENVIRONMENT=development
DATABASE_URL=sqlite:///./flagwarden.db
TELEGRAM_BOT_TOKEN=development-bot-token
TELEGRAM_WEBHOOK_SECRET=development-webhook-secret
ANSWER_PEPPER=development-only-change-me
MINIAPP_AUTH_MAX_AGE_SECONDS=300
ADMIN_TELEGRAM_IDS=10001
REVIEWER_TELEGRAM_IDS=10002
AUTHOR_TELEGRAM_IDS=10003
ALLOW_DEBUG_AUTH=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MINIAPP_URL=http://127.0.0.1:8000/app/
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://redis:6379/0
OTEL_ENABLED=false
